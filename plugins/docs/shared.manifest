# Shared sources materialized into this plugin.
#   <path under shared/>  ->  <path under this plugin>
#
# Destinations are per-skill: a SKILL.md resolves bundled paths relative to its own
# folder, so each skill needs its own copy.
#
# Regenerate with: python3 tools/materialize.py

scripts/scan_repo.py             -> skills/document-codebase/scripts/scan_repo.py
scripts/validate_index.py        -> skills/document-codebase/scripts/validate_index.py
scripts/annotate_import_usage.py -> skills/document-codebase/scripts/annotate_import_usage.py
scripts/query_graph.py           -> skills/document-codebase/scripts/query_graph.py
scripts/verify_doc.py            -> skills/document-codebase/scripts/verify_doc.py
scripts/build_document_model.py  -> skills/document-codebase/scripts/build_document_model.py
scripts/render_docs.py           -> skills/document-codebase/scripts/render_docs.py
scripts/sphinx_support.py        -> skills/document-codebase/scripts/sphinx_support.py
scripts/wire_toctree.py          -> skills/document-codebase/scripts/wire_toctree.py
scripts/build_class_graph.py     -> skills/document-codebase/scripts/build_class_graph.py
scripts/build_diagrams.py        -> skills/document-codebase/scripts/build_diagrams.py
scripts/validate_diagrams.py     -> skills/document-codebase/scripts/validate_diagrams.py
scripts/assemble.py              -> skills/document-codebase/scripts/assemble.py
